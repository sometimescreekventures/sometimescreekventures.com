---
import { contact, stories } from '../../data/site';
const panes = stories.slice(0, 4);
const glassCols = [
  'linear-gradient(155deg, #1c5f8a, #2a86b8)',
  'linear-gradient(155deg, #8a2a1c, #c05a2a)',
  'linear-gradient(155deg, #2a6d38, #5aa04a)',
  'linear-gradient(155deg, #5a2a7a, #8a4aa8)',
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" /><title>Concept: Patron Saint</title>
  </head>
  <body>
    <main>
      <section class="window">
        <div class="arch">
          <div class="rose" aria-hidden="true">
            <span class="petal p1"></span><span class="petal p2"></span><span class="petal p3"></span>
            <span class="petal p4"></span><span class="petal p5"></span><span class="petal p6"></span>
            <span class="core">⚙</span>
          </div>
          <h1>ST. SEAN<br />OF THE SHIPPED</h1>
          <p class="latin">PATRONUS · DEADLINE · IMPOSSIBILIUM</p>
          <p class="creed">
            Patron of impossible timelines, rescuer of doomed systems.
            Twenty-plus years of documented miracles: 36 seconds made 95
            milliseconds; one engineer made an entire department.
          </p>
        </div>
        <div class="panes">
          {panes.map((s, i) => (
            <article class="pane" style={`--g:${glassCols[i]}`}>
              <h2>MIRACLE {['I', 'II', 'III', 'IV'][i]}</h2>
              <b>{s.hook}</b>
              <p>{s.story}</p>
            </article>
          ))}
        </div>
        <div class="altar">
          <a class="votive" href={`mailto:${contact.email}`}>🕯 LIGHT A CANDLE → {contact.email}</a>
          <p class="fine">OFFERINGS ACCEPTED IN THE FORM OF INTERESTING PROBLEMS · GEORGETOWN, TX</p>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  * { margin: 0; box-sizing: border-box; }
  body { background: #171412; color: #f2ead8; font-family: Georgia, serif; min-height: 100vh; display: grid; place-items: center; padding: 3rem 1rem; }
  .window { max-width: 56rem; }
  .arch {
    text-align: center; background: linear-gradient(#241e1a, #171412); border: 10px solid #3a2f26;
    border-radius: 50% 50% 0 0 / 26% 26% 0 0; padding: 3.5rem 2rem 2rem; box-shadow: inset 0 0 60px rgba(0,0,0,0.7);
  }
  .rose { position: relative; width: 8rem; height: 8rem; margin: 0 auto 1.5rem; }
  .petal { position: absolute; left: 50%; top: 50%; width: 2.6rem; height: 3.6rem; border-radius: 50% 50% 0 50%; border: 3px solid #3a2f26; opacity: 0.92; }
  .p1 { background: #2a86b8; transform: translate(-50%, -50%) rotate(0deg) translateY(-2.2rem); }
  .p2 { background: #c05a2a; transform: translate(-50%, -50%) rotate(60deg) translateY(-2.2rem); }
  .p3 { background: #5aa04a; transform: translate(-50%, -50%) rotate(120deg) translateY(-2.2rem); }
  .p4 { background: #8a4aa8; transform: translate(-50%, -50%) rotate(180deg) translateY(-2.2rem); }
  .p5 { background: #c0a02a; transform: translate(-50%, -50%) rotate(240deg) translateY(-2.2rem); }
  .p6 { background: #b83a5a; transform: translate(-50%, -50%) rotate(300deg) translateY(-2.2rem); }
  .core { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 2.6rem; height: 2.6rem; display: grid; place-items: center; border-radius: 50%; background: #f2d75e; color: #171412; font-size: 1.3rem; border: 3px solid #3a2f26; }
  h1 { font-size: clamp(2rem, 6vw, 3.6rem); letter-spacing: 0.12em; line-height: 1.05; }
  .latin { margin-top: 0.8rem; font-size: 0.68rem; letter-spacing: 0.5em; color: #b8a678; }
  .creed { margin: 1.5rem auto 0; max-width: 34rem; font-size: 0.95rem; line-height: 1.8; color: #d8ccae; }
  .panes { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0; border: 10px solid #3a2f26; border-top: 6px solid #3a2f26; }
  .pane { background: var(--g); border: 5px solid #3a2f26; padding: 1.5rem 1.1rem; text-align: center; min-height: 15rem; box-shadow: inset 0 0 40px rgba(0,0,0,0.35), inset 0 0 12px rgba(255,255,255,0.18); }
  .pane h2 { font-size: 0.68rem; letter-spacing: 0.4em; color: rgba(255,255,255,0.85); }
  .pane b { display: block; margin-top: 0.7rem; font-size: 1.05rem; letter-spacing: 0.04em; color: #fff; }
  .pane p { margin-top: 0.7rem; font-family: system-ui, sans-serif; font-size: 0.72rem; line-height: 1.6; color: rgba(255,255,255,0.85); }
  .altar { text-align: center; border: 10px solid #3a2f26; border-top: 0; padding: 1.75rem 1rem; background: #241e1a; }
  .votive { color: #f2d75e; font-weight: 700; text-decoration: none; letter-spacing: 0.08em; }
  .votive:hover { text-shadow: 0 0 16px rgba(242, 215, 94, 0.7); }
  .fine { margin-top: 0.9rem; font-family: system-ui, sans-serif; font-size: 0.58rem; letter-spacing: 0.28em; color: #8a7d62; }
</style>
