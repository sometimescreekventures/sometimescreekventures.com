---
import { contact } from '../data/site';

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/open-source', label: 'Open Source' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b-4 border-ink">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-sm font-extrabold tracking-wide text-ink uppercase hover:text-accent-deep"
    >
      Sometimes Creek Ventures<span class="text-accent">.</span>
    </a>
    <nav aria-label="Main" class="flex items-baseline gap-5 sm:gap-7">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={
              path === item.href || path.startsWith(item.href + '/')
                ? 'page'
                : undefined
            }
            class:list={[
              'text-sm font-semibold tracking-wide uppercase',
              path === item.href || path.startsWith(item.href + '/')
                ? 'text-accent-deep underline decoration-2 underline-offset-4'
                : 'text-ink hover:text-accent-deep',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={`mailto:${contact.email}`}
        class="text-sm font-semibold tracking-wide text-ink uppercase hover:text-accent-deep"
      >
        Contact <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
