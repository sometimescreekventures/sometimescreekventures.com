---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import { clients, contact, engagements, person, site } from '../data/site';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Home rows lead with each case study's strongest number. */
const leads: Record<string, { value: string; label: string }> = {
  'cvs-health': {
    value: '15+',
    label: 'engineer squad led on a Fortune-5 program',
  },
  cardio: { value: '99%', label: 'of the platform built solo — ~513 commits' },
  zonal: { value: '~99%', label: 'p95 reduction on core endpoints, under load' },
};
---

<Base
  title="Sean Denton — Cloud & AI Solutions Architect | Sometimes Creek Ventures"
  description={site.description}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-12 sm:px-8 sm:pt-20 sm:pb-16">
    <p class="text-sm font-semibold tracking-widest uppercase">
      {person.name} — independent, senior, hands-on
    </p>
    <h1
      class="mt-6 font-display leading-[0.92] font-extrabold tracking-tight uppercase"
      style="font-size: clamp(3rem, 11.5vw, 8.5rem);"
    >
      <span class="block">Cloud &amp; AI</span>
      <span class="outline-word block">Solutions</span>
      <span class="block">Architect<span class="text-accent">.</span></span>
    </h1>
    <div
      class="mt-8 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-5"
    >
      <p class="max-w-xl text-lg leading-relaxed font-medium text-graphite">
        {person.thesis}
      </p>
      <div class="flex flex-wrap items-baseline gap-6">
        <a
          href={`mailto:${contact.email}`}
          class="max-w-full bg-ink px-4 py-3 text-[13px] font-bold tracking-wide break-all text-paper uppercase hover:bg-accent-deep sm:px-5 sm:text-sm"
        >
          {contact.email}
        </a>
        <a
          href="/work"
          class="text-sm font-bold tracking-wide text-ink uppercase underline decoration-accent decoration-4 underline-offset-4 hover:text-accent-deep"
        >
          See the work <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <Marquee items={clients} label="Client engagements" />

  <!-- 01 Selected work -->
  <section
    aria-labelledby="work-heading"
    class="mx-auto max-w-6xl px-5 pt-16 sm:px-8"
  >
    <SectionHead number="01" title="Selected work">
      <a
        href="/work"
        class="text-sm font-bold tracking-wide text-ink uppercase underline decoration-accent decoration-4 underline-offset-4 hover:text-accent-deep"
      >
        All case studies <span aria-hidden="true">→</span>
      </a>
    </SectionHead>
    <div class="mt-8">
      {
        work.map((entry) => (
          <WorkCard
            href={`/work/${entry.data.slug}`}
            client={entry.data.client}
            title={entry.data.title}
            summary={entry.data.summary}
            lead={leads[entry.data.slug] ?? entry.data.stats[0]!}
          />
        ))
      }
    </div>
  </section>

  <!-- 02 Ways to engage -->
  <section
    aria-labelledby="engage-heading"
    class="mx-auto max-w-6xl px-5 pt-16 sm:px-8"
  >
    <SectionHead number="02" title="Ways to engage" />
    <dl class="mt-8">
      {
        engagements.map((engagement) => (
          <div class="grid gap-x-8 gap-y-1 border-t border-ink py-6 sm:grid-cols-[minmax(11rem,18rem)_1fr]">
            <dt class="font-display text-lg font-extrabold tracking-tight uppercase">
              {engagement.name}
            </dt>
            <dd class="leading-relaxed text-graphite">{engagement.detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 03 Open source -->
  <section
    aria-labelledby="oss-heading"
    class="mx-auto max-w-6xl px-5 pt-16 sm:px-8"
  >
    <SectionHead number="03" title="Open source">
      <a
        href="/open-source"
        class="text-sm font-bold tracking-wide text-ink uppercase underline decoration-accent decoration-4 underline-offset-4 hover:text-accent-deep"
      >
        Why these exist <span aria-hidden="true">→</span>
      </a>
    </SectionHead>
    <div class="mt-8">
      {
        projects.map((project) => (
          <div class="grid gap-x-8 gap-y-1 border-t border-ink py-6 sm:grid-cols-[minmax(11rem,18rem)_1fr]">
            <h3>
              <a
                href={project.data.repoUrl}
                class="font-display text-lg font-extrabold tracking-tight text-ink uppercase hover:text-accent-deep"
              >
                {project.data.title}
                <span aria-hidden="true" class="text-accent-deep">↗</span>
              </a>
            </h3>
            <p class="leading-relaxed text-graphite">{project.data.tagline}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
