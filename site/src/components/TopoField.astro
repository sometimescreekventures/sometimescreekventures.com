---
/**
 * A field of elevation contours, generated deterministically at build time.
 * Nested irregular rings around two "peaks", like a topographic survey of
 * Hill Country terrain. Rendered as low-contrast strokes on the night bands.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const TWO_PI = Math.PI * 2;
const STEPS = 72;

function ring(
  cx: number,
  cy: number,
  radius: number,
  seed: number,
  squash: number,
): string {
  const pts: string[] = [];
  for (let i = 0; i <= STEPS; i++) {
    const t = (i / STEPS) * TWO_PI;
    const wobble =
      Math.sin(t * 3 + seed) * 0.14 +
      Math.sin(t * 5 + seed * 2.3) * 0.08 +
      Math.sin(t * 9 + seed * 4.7) * 0.04;
    const r = radius * (1 + wobble);
    const x = cx + Math.cos(t) * r * 1.7;
    const y = cy + Math.sin(t) * r * squash;
    pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M${pts.join(' L')} Z`;
}

interface Peak {
  cx: number;
  cy: number;
  base: number;
  rings: number;
  seed: number;
  squash: number;
}

const peaks: Peak[] = [
  { cx: 250, cy: 420, base: 52, rings: 6, seed: 1.7, squash: 0.82 },
  { cx: 900, cy: 90, base: 60, rings: 7, seed: 4.2, squash: 0.9 },
  { cx: 1180, cy: 470, base: 46, rings: 5, seed: 7.9, squash: 0.85 },
];

const contours = peaks.flatMap((peak) =>
  Array.from({ length: peak.rings }, (_, i) => ({
    d: ring(peak.cx, peak.cy, peak.base * (i + 1), peak.seed + i * 0.9, peak.squash),
    opacity: 0.5 - i * 0.055,
  })),
);
---

<svg
  viewBox="0 0 1200 560"
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid slice"
  class={className}
>
  {
    contours.map((contour) => (
      <path
        d={contour.d}
        stroke="var(--color-contour)"
        stroke-width="1"
        opacity={contour.opacity}
      />
    ))
  }
</svg>
