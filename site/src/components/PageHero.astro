---
/**
 * Dark topographic title band used at the top of every subpage,
 * echoing the home hero so the whole site shares one signature.
 */
import TopoField from './TopoField.astro';

interface Props {
  eyebrow?: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="on-night relative overflow-hidden bg-night text-bone">
  <TopoField class="pointer-events-none absolute inset-0 h-full w-full" />
  <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-12 sm:px-8 sm:pt-18 sm:pb-16">
    {
      eyebrow && (
        <p class="text-xs font-medium tracking-widest text-glow uppercase">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mt-3 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"
    >
      {title}
    </h1>
    <slot />
  </div>
</section>
