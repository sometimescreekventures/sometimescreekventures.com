---
import { contact, person, site } from '../data/site';
---

<footer class="mt-24 border-t-4 border-ink">
  <section
    aria-labelledby="contact-heading"
    class="mx-auto max-w-6xl px-5 py-14 sm:px-8"
  >
    <h2
      id="contact-heading"
      class="font-display text-sm font-extrabold tracking-widest text-fog uppercase"
    >
      Have something that needs to ship?
    </h2>
    <a
      href={`mailto:${contact.email}`}
      class="mt-4 inline-block max-w-full font-display text-[clamp(1.15rem,4.8vw,3.2rem)] leading-tight font-extrabold tracking-tight break-all text-ink underline decoration-accent decoration-4 underline-offset-8 hover:text-accent-deep"
    >
      {contact.email}
    </a>
    <p class="mt-6 max-w-xl leading-relaxed text-graphite">
      Every engagement runs through {site.legalName}. A couple of sentences
      about what you're building is plenty.
    </p>
  </section>
  <div class="border-t-4 border-ink bg-ink text-paper">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-5 py-5 text-xs font-semibold tracking-widest uppercase sm:px-8"
    >
      <p>© {site.legalName}</p>
      <div class="flex gap-6">
        <a href={contact.linkedin} class="hover:text-accent">LinkedIn</a>
        <a href={contact.github} class="hover:text-accent">GitHub</a>
      </div>
      <p>{person.location}</p>
    </div>
  </div>
</footer>
