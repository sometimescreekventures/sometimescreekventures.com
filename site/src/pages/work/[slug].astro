---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatRow from '../../components/StatRow.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.client}: ${entry.data.title} | Sometimes Creek Ventures`}
  description={entry.data.summary}
>
  <article class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
    <header>
      <p class="text-xs font-semibold tracking-widest text-accent-deep uppercase">
        {entry.data.client} · {entry.data.role}
      </p>
      <h1
        class="mt-4 max-w-4xl font-display leading-[0.98] font-extrabold tracking-tight uppercase"
        style="font-size: clamp(2.2rem, 6.5vw, 4.5rem);"
      >
        {entry.data.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed font-medium text-graphite">
        {entry.data.summary}
      </p>
    </header>

    <StatRow stats={entry.data.stats} class="mt-10" />

    <div class="prose-scv mt-4">
      <Content />
    </div>

    <footer class="mt-14">
      <h2 class="text-xs font-semibold tracking-widest text-fog uppercase">
        Stack
      </h2>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
        {
          entry.data.stack.map((item) => (
            <li class="text-sm font-semibold text-graphite">
              <span aria-hidden="true" class="text-accent-deep">[</span>
              {item}
              <span aria-hidden="true" class="text-accent-deep">]</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a
          href="/work"
          class="text-sm font-bold tracking-wide text-ink uppercase underline decoration-accent decoration-4 underline-offset-4 hover:text-accent-deep"
        >
          <span aria-hidden="true">←</span> All case studies
        </a>
      </p>
    </footer>
  </article>
</Base>
