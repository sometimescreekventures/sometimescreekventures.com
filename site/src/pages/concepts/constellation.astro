---
import { contact, stories } from '../../data/site';
const named = stories.slice(0, 5);
const starPos = [
  [18, 28], [36, 14], [55, 30], [72, 18], [84, 42],
  [30, 48], [50, 56], [68, 62], [22, 70], [60, 80],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" /><title>Concept: Constellation</title>
  </head>
  <body>
    <main>
      <header class="head">
        <h1>CARTA CAELESTIS</h1>
        <p>THE DENTON CONSTELLATION · AS OBSERVED FROM GEORGETOWN, TX · MAGNITUDE: SHIPS EVERYTHING</p>
      </header>
      <div class="sky">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <polyline points="18,28 36,14 55,30 72,18 84,42 68,62 50,56 30,48 18,28" fill="none" stroke="#c9a961" stroke-width="0.25" />
          <polyline points="30,48 22,70 60,80 68,62" fill="none" stroke="#c9a961" stroke-width="0.25" />
        </svg>
        {starPos.map(([x, y], i) => (
          <span class={`star ${i < 5 ? 'major' : ''}`} style={`left:${x}%; top:${y}%;`}></span>
        ))}
        {named.map((s, i) => (
          <span class="label" style={`left:${starPos[i][0]}%; top:${starPos[i][1]}%;`}>
            α{i + 1} — {s.hook}
          </span>
        ))}
        <span class="compass" aria-hidden="true">✦ N</span>
      </div>
      <section class="atlas">
        {named.map((s, i) => (
          <p><b>α{i + 1} {s.hook}.</b> {s.story}</p>
        ))}
      </section>
      <footer class="obs">
        <p>TO COMMISSION AN OBSERVATION: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p class="fine">FIXED STARS ONLY — NOTHING HERE IS VAPOR · TWENTY-PLUS YEARS OF RECORDED LIGHT</p>
      </footer>
    </main>
  </body>
</html>

<style>
  * { margin: 0; box-sizing: border-box; }
  body { background: #0c1226; color: #e8e2d0; font-family: Georgia, serif; padding: 3rem 1.25rem 4rem;
    background-image: radial-gradient(circle at 80% 10%, rgba(201, 169, 97, 0.08), transparent 45%); }
  main { max-width: 60rem; margin: 0 auto; }
  .head { text-align: center; }
  h1 { font-size: clamp(2rem, 6vw, 3.6rem); letter-spacing: 0.24em; font-weight: 500; }
  .head p { margin-top: 0.7rem; font-family: system-ui, sans-serif; font-size: 0.62rem; letter-spacing: 0.3em; color: #9a916f; }
  .sky { position: relative; margin-top: 2rem; aspect-ratio: 16/10; border: 1px solid #c9a961; border-radius: 4px; background: radial-gradient(circle at 30% 40%, #101a38, #0c1226 70%); overflow: hidden; }
  .sky svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .star { position: absolute; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: #e8e2d0; box-shadow: 0 0 6px #e8e2d0; transform: translate(-50%, -50%); }
  .star.major { width: 0.6rem; height: 0.6rem; background: #c9a961; box-shadow: 0 0 12px #c9a961; }
  @media (prefers-reduced-motion: no-preference) {
    .star { animation: tw 3.4s ease-in-out infinite alternate; }
    .star:nth-child(odd) { animation-delay: -1.7s; }
    @keyframes tw { to { opacity: 0.45; } }
  }
  .label { position: absolute; transform: translate(0.7rem, -50%); font-family: system-ui, sans-serif; font-size: 0.6rem; letter-spacing: 0.14em; color: #c9a961; text-transform: uppercase; white-space: nowrap; }
  .compass { position: absolute; right: 1rem; bottom: 0.8rem; color: #9a916f; font-size: 0.8rem; letter-spacing: 0.2em; }
  .atlas { margin-top: 2rem; columns: 2 20rem; column-gap: 2.5rem; }
  .atlas p { font-size: 0.9rem; line-height: 1.7; color: #beb69c; margin-bottom: 1rem; break-inside: avoid; }
  .atlas b { color: #e8e2d0; }
  .obs { margin-top: 2rem; border-top: 1px solid #c9a961; padding-top: 1.25rem; text-align: center; }
  .obs a { color: #c9a961; font-weight: 700; }
  .fine { margin-top: 0.7rem; font-family: system-ui, sans-serif; font-size: 0.58rem; letter-spacing: 0.28em; color: #9a916f; }
</style>
