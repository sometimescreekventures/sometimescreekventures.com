---
interface Props {
  href: string;
  client: string;
  title: string;
  summary: string;
  lead: { value: string; label: string };
}

const { href, client, title, summary, lead } = Astro.props;
---

<a
  href={href}
  class="group lift flex h-full flex-col rounded-lg border border-silt bg-bone p-6 hover:border-river"
>
  <p class="text-xs font-medium tracking-widest text-flint uppercase">
    {client}
  </p>
  <p class="mt-4 font-display text-3xl font-semibold tracking-tight tabular-nums">
    {lead.value}
  </p>
  <p class="mt-1 text-sm text-flint">{lead.label}</p>
  <h3 class="mt-5 font-display text-lg leading-snug font-semibold tracking-tight">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-flint">{summary}</p>
  <p class="mt-5 text-sm font-medium text-river group-hover:text-river-deep">
    Read the case study <span aria-hidden="true">→</span>
  </p>
</a>
