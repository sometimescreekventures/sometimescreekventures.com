---
import Base from '../layouts/Base.astro';
import CreekLine from '../components/CreekLine.astro';
import TopoField from '../components/TopoField.astro';
---

<Base
  title="Page not found | Sometimes Creek Ventures"
  description="This page doesn't exist. The creek bed is dry here."
>
  <section class="on-night relative overflow-hidden bg-night text-bone">
    <TopoField class="pointer-events-none absolute inset-0 h-full w-full" />
    <div class="relative mx-auto max-w-5xl px-5 pt-24 pb-20 sm:px-8 sm:pt-32">
      <p
        class="font-display text-7xl font-semibold tracking-tight text-glow tabular-nums"
      >
        404
      </p>
      <h1 class="mt-4 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
        Dry creek bed.
      </h1>
      <p class="mt-3 max-w-md leading-relaxed text-mist">
        Nothing flows through this channel. The page you're looking for doesn't
        exist — or has moved downstream.
      </p>
      <div class="mt-6">
        <CreekLine tone="dark" />
      </div>
      <p class="mt-8">
        <a
          href="/"
          class="inline-block rounded-md bg-glow px-5 py-2.5 text-sm font-semibold text-night hover:bg-glow-soft"
        >
          Back to the source
        </a>
      </p>
    </div>
  </section>
</Base>
