---
import { contact, stories } from '../../data/site';
const picks = stories.slice(0, 4);
---

<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" /><title>Concept: Noir</title>
  </head>
  <body>
    <main>
      <p class="studio">SOMETIMES CREEK VENTURES PRESENTS</p>
      <h1 class="title">THE MAN WHO<br />SHIPS AT<br />MIDNIGHT</h1>
      <p class="tagline">Every system was impossible. He built them anyway.</p>
      <div class="beam" aria-hidden="true"></div>
      <section class="acts">
        {picks.map((s, i) => (
          <article>
            <p class="act">ACT {['I', 'II', 'III', 'IV'][i]}</p>
            <h2>{s.hook.toUpperCase()}</h2>
            <p class="line">{s.story}</p>
          </article>
        ))}
      </section>
      <section class="credits">
        <p class="starring">STARRING</p>
        <p class="name">SEAN DENTON</p>
        <p class="roles">AS THE ARCHITECT · THE TECH LEAD · THE CTO · AND THE GUY STILL WRITING THE CODE</p>
        <div class="block">
          <p>DIRECTED BY <b>SEAN DENTON</b> · WRITTEN BY <b>SEAN DENTON</b> · PRODUCED BY <b>SEAN DENTON</b></p>
          <p>SHOT ON LOCATION IN <b>GEORGETOWN, TX</b> · RUNNING TIME <b>20+ YEARS</b> · NOT RATED — <b>PROVEN</b></p>
        </div>
        <a class="ticket" href={`mailto:${contact.email}`}>NOW CASTING YOUR PROJECT → {contact.email}</a>
      </section>
    </main>
  </body>
</html>

<style>
  * { margin: 0; box-sizing: border-box; }
  body {
    background:
      radial-gradient(circle at 50% 12%, rgba(255,255,255,0.13), transparent 45%),
      #0a0a0a;
    color: #e8e8e8; font-family: Georgia, 'Times New Roman', serif; padding: 4rem 1.5rem; text-align: center;
  }
  main { max-width: 54rem; margin: 0 auto; position: relative; }
  .studio { font-family: system-ui, sans-serif; font-size: 0.65rem; letter-spacing: 0.5em; color: #8a8a8a; }
  .title {
    margin-top: 1.5rem; font-weight: 700; font-size: clamp(2.8rem, 10vw, 6.5rem); line-height: 0.98; letter-spacing: 0.04em;
    text-shadow: 0 0 40px rgba(255,255,255,0.28);
  }
  .tagline { margin-top: 1.5rem; font-style: italic; font-size: 1.15rem; color: #b8b8b8; }
  .beam {
    position: absolute; left: 50%; top: -4rem; width: 34rem; height: 30rem; pointer-events: none;
    background: conic-gradient(from 194deg at 50% 0%, transparent 0deg, rgba(255,255,255,0.09) 14deg, transparent 32deg);
    transform: translateX(-50%);
  }
  .acts { margin-top: 4rem; display: grid; gap: 2.5rem; text-align: center; }
  .act { font-family: system-ui, sans-serif; font-size: 0.62rem; letter-spacing: 0.5em; color: #8a8a8a; }
  h2 { margin-top: 0.5rem; font-size: 1.35rem; letter-spacing: 0.14em; }
  .line { margin: 0.7rem auto 0; max-width: 38rem; font-family: system-ui, sans-serif; font-size: 0.88rem; line-height: 1.7; color: #a8a8a8; }
  .credits { margin-top: 4.5rem; border-top: 1px solid #333; padding-top: 2.5rem; }
  .starring { font-family: system-ui, sans-serif; font-size: 0.62rem; letter-spacing: 0.5em; color: #8a8a8a; }
  .name { margin-top: 0.7rem; font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: 0.22em; font-weight: 700; }
  .roles { margin-top: 0.7rem; font-family: system-ui, sans-serif; font-size: 0.68rem; letter-spacing: 0.22em; color: #b8b8b8; }
  .block { margin-top: 2rem; font-family: system-ui, sans-serif; font-size: 0.62rem; letter-spacing: 0.14em; color: #8a8a8a; line-height: 2.1; }
  .block b { color: #d8d8d8; }
  .ticket { display: inline-block; margin-top: 2.25rem; font-family: system-ui, sans-serif; font-size: 0.8rem; letter-spacing: 0.14em; font-weight: 700; color: #0a0a0a; background: #e8e8e8; padding: 0.85rem 1.4rem; text-decoration: none; }
  .ticket:hover { background: #fff; box-shadow: 0 0 30px rgba(255,255,255,0.4); }
</style>
