---
/**
 * The signature element: a single meandering creek line.
 * variant="hero" threads the dark hero band (luminous, with a soft glow);
 * variant="divider" separates light sections; tone="dark" renders the
 * divider for night bands.
 */
interface Props {
  variant?: 'hero' | 'divider';
  tone?: 'light' | 'dark';
  animate?: boolean;
  class?: string;
}

const {
  variant = 'divider',
  tone = 'light',
  animate = false,
  class: className = '',
} = Astro.props;

const heroPath =
  'M-20 128 C 90 122, 150 84, 235 80 C 330 76, 355 132, 450 128 C 545 124, 580 60, 665 52 C 760 44, 800 96, 880 100 C 970 104, 1010 48, 1090 40 C 1150 34, 1190 52, 1230 48';
const dividerPath =
  'M0 10 C 22 9, 32 4, 50 4 C 70 4, 74 12, 94 12 C 114 12, 120 5, 140 4 C 160 3, 168 11, 188 11 C 208 11, 220 6, 240 6';
---

{
  variant === 'hero' ? (
    <svg
      viewBox="0 0 1200 160"
      fill="none"
      aria-hidden="true"
      preserveAspectRatio="none"
      class={className}
    >
      <defs>
        <filter id="creek-blur" x="-5%" y="-80%" width="110%" height="260%">
          <feGaussianBlur stdDeviation="6" />
        </filter>
      </defs>
      <path
        d={heroPath}
        stroke="var(--color-glow)"
        stroke-width="7"
        stroke-linecap="round"
        opacity="0.35"
        filter="url(#creek-blur)"
        vector-effect="non-scaling-stroke"
      />
      <path
        class:list={['creek-path', { 'creek-path--animate': animate }]}
        pathLength="1"
        d={heroPath}
        stroke="var(--color-glow)"
        stroke-width="2"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
      <path
        d="M-20 142 C 95 136, 160 100, 245 96 C 335 92, 362 146, 455 142 C 548 138, 588 80, 672 72 C 762 64, 806 112, 886 116 C 972 120, 1016 68, 1094 60 C 1152 54, 1192 70, 1230 66"
        stroke="var(--color-contour)"
        stroke-width="1"
        stroke-linecap="round"
        opacity="0.9"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  ) : (
    <svg
      viewBox="0 0 240 16"
      fill="none"
      aria-hidden="true"
      class={`h-4 w-60 ${className}`}
    >
      <path
        d={dividerPath}
        stroke={tone === 'dark' ? 'var(--color-glow)' : 'var(--color-river)'}
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
  )
}
