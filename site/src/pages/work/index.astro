---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Work — Sean Denton | Sometimes Creek Ventures"
  description="Case studies: a Fortune-5 cloud platform automation program, a HIPAA remote patient-monitoring platform built solo, and a performance rescue proven against baselines."
>
  <PageHero eyebrow="Case studies" title="Work">
    <p class="mt-4 max-w-2xl leading-relaxed text-mist">
      Three engagements, three shapes of the same job: own the hard parts —
      architecture, data and security model, infrastructure, path to
      production — and stay accountable until it runs.
    </p>
  </PageHero>
  <div class="mx-auto max-w-5xl px-5 pt-12 sm:px-8">
    <div class="grid gap-5 md:grid-cols-3">
      {
        work.map((entry) => (
          <WorkCard
            href={`/work/${entry.data.slug}`}
            client={entry.data.client}
            title={entry.data.title}
            summary={entry.data.summary}
            lead={entry.data.stats[0]!}
          />
        ))
      }
    </div>
  </div>
</Base>
