---
import VariantSwitcher from '../components/VariantSwitcher.astro';
import {
  clients,
  contact,
  method,
  now,
  person,
  site,
  stack,
  stories,
} from '../data/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Flash Flood — Sean Denton | Sometimes Creek Ventures</title>
    <meta name="description" content={site.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="alertbar" role="presentation">
      ⚠ FLASH FLOOD WARNING — SOMETIMES CREEK BASIN — EXTREME OUTPUT CAPABILITY DETECTED — SHELTER YOUR BACKLOG ⚠
    </div>
    <main>
      <header class="head">
        <span class="callsign">KSCV DOPPLER · GEORGETOWN, TX</span>
        <span>SEVERE ENGINEERING OUTLOOK — VALID INDEFINITELY</span>
      </header>

      <!-- Hero -->
      <section class="radar-wrap">
        <div class="radar" aria-hidden="true">
          <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>
          <div class="cross"></div>
          <div class="cell c1"></div><div class="cell c2"></div><div class="cell c3"></div>
          <div class="sweep"></div>
          <span class="ptag" style="left:58%; top:30%">CELL: ROCKETS</span>
          <span class="ptag" style="left:22%; top:55%">CELL: HOSPITALS</span>
          <span class="ptag" style="left:64%; top:70%">CELL: TRACTORS</span>
        </div>
        <div class="bulletin">
          <p class="kicker">SPECIAL WEATHER STATEMENT</p>
          <h1>THE CREEK IS DRY —<br />UNTIL IT ISN'T<span class="warn">.</span></h1>
          <p class="body">
            {person.name} is a sometimes creek: a dormant channel with
            flash-flood capacity. When the rain comes — a launch, an outage, a
            deadline — the water runs hard: systems from nothing to production,
            crew of one.
          </p>
          <p class="scale">
            STORM SCALE: CAT-20+ YEARS · MAX RECORDED SURGE: 36s → 95ms ·
            SUSTAINED PLAYERS: 250,000
          </p>
          <a class="cta" href={`mailto:${contact.email}`}>ISSUE A WATCH → {contact.email}</a>
        </div>
      </section>

      <!-- Storm reports: the list -->
      <section class="block" aria-labelledby="reports-h">
        <h2 class="rtitle" id="reports-h">STORM REPORTS — CONFIRMED TOUCHDOWNS</h2>
        {
          stories.map((item) => (
            <div class="report">
              <span class="badge">CONFIRMED</span>
              <p>
                <b>{item.hook.toUpperCase()}.</b> {item.story}
              </p>
            </div>
          ))
        }
      </section>

      <!-- Method -->
      <section class="block" aria-labelledby="method-h">
        <h2 class="rtitle" id="method-h">FORECAST METHODOLOGY</h2>
        <p class="loop">
          {method.loop.map((step, i) => (
            <>
              <span class="step">{step.toUpperCase()}</span>
              {i < method.loop.length - 1 && <span class="arrow" aria-hidden="true"> ▸ </span>}
            </>
          ))}
        </p>
        <ul class="lines">
          {method.lines.map((line) => <li>{line}</li>)}
        </ul>
      </section>

      <!-- Stack -->
      <section class="block" aria-labelledby="stack-h">
        <h2 class="rtitle" id="stack-h">INSTRUMENTATION</h2>
        <div class="stack-grid">
          {
            stack.map((group) => (
              <div class="inst">
                <h3>{group.label.toUpperCase()}</h3>
                <p class="inst-note">{group.note}</p>
                <p class="inst-items">{group.items.join(' · ')}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Now -->
      <section class="block" aria-labelledby="now-h">
        <h2 class="rtitle" id="now-h">ACTIVE CELLS — TRACKING NOW</h2>
        <ul class="active">
          {
            now.map((item) => (
              <li>
                <span class="live" aria-hidden="true" />
                {item.what}
                {'links' in item &&
                  item.links?.map((link) => (
                    <a class="alink" href={link.href}>
                      [{link.label} ↗]
                    </a>
                  ))}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Me -->
      <section class="block" aria-labelledby="me-h">
        <h2 class="rtitle" id="me-h">STATION HISTORY</h2>
        <div class="prose">
          <p>
            I'm a petroleum engineer by degree — The University of Texas at
            Austin — who's spent twenty-plus years shipping software instead.
            I've been the CTO, the principal architect, the tech lead, and the
            contractor who parachutes in when it's on fire. I hold a patent on
            browser-based content protection, I speak about this stuff in
            public, and I forecast from Georgetown, Texas.
          </p>
          <p>
            Full stack means all of it: set the vision with your founders in
            the morning, design the data model at lunch, code in review by the
            end of the day. I lead teams when there's a team and carry the
            whole thing when there isn't. What I care about is the product
            actually leaving the building — not the deck about it.
          </p>
        </div>
        <p class="stations">
          REPORTING STATIONS ALONG THE WAY: {clients.join(' · ')} · PATENT US 8,887,290 B1
        </p>
      </section>

      <footer class="foot">
        <a class="cta" href={`mailto:${contact.email}`}>OPEN A CHANNEL → {contact.email}</a>
        <p class="foot-links">
          <a href={contact.linkedin}>LINKEDIN</a> · <a href={contact.github}>GITHUB</a> · © {site.legalName}
        </p>
      </footer>
    </main>
    <VariantSwitcher current="flood" />
  </body>
</html>

<style>
  * { margin: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { background: #0a0f14; color: #dfe8ee; font-family: system-ui, sans-serif; }
  .alertbar {
    background: repeating-linear-gradient(45deg, #d92b2b 0 24px, #8f1414 24px 48px);
    color: #fff; font-weight: 800; letter-spacing: 0.08em; font-size: 0.8rem;
    padding: 0.6rem 1rem; text-align: center; text-shadow: 0 1px 2px rgba(0,0,0,0.6);
  }
  main { max-width: 68rem; margin: 0 auto; padding: 1.5rem 1rem 6rem; }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1.5rem; font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.18em; color: #7b8ea0; padding-bottom: 1.25rem; }
  .callsign { color: #35e06f; }
  .radar-wrap { display: grid; gap: 2rem; grid-template-columns: minmax(17rem, 1fr) 1.3fr; align-items: center; }
  .radar { position: relative; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, #06220f 0%, #041508 70%, #020a04 100%); border: 2px solid #123420; overflow: hidden; }
  .ring { position: absolute; inset: 0; border: 1px solid rgba(53, 224, 111, 0.25); border-radius: 50%; }
  .r2 { inset: 16%; } .r3 { inset: 33%; }
  .cross { position: absolute; inset: 0; background:
    linear-gradient(rgba(53,224,111,0.18), rgba(53,224,111,0.18)) 50% 0 / 1px 100% no-repeat,
    linear-gradient(rgba(53,224,111,0.18), rgba(53,224,111,0.18)) 0 50% / 100% 1px no-repeat; }
  .cell { position: absolute; border-radius: 50%; filter: blur(6px); }
  .c1 { left: 52%; top: 18%; width: 26%; height: 22%; background: radial-gradient(circle, #d92b2b 0%, #e8a020 55%, #2ea043 90%, transparent 100%); }
  .c2 { left: 12%; top: 46%; width: 22%; height: 20%; background: radial-gradient(circle, #e8a020 0%, #2ea043 70%, transparent 100%); }
  .c3 { left: 55%; top: 60%; width: 20%; height: 18%; background: radial-gradient(circle, #d92b2b 10%, #e8a020 50%, #2ea043 85%, transparent 100%); }
  .sweep { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, rgba(53,224,111,0.5), transparent 70deg); }
  @media (prefers-reduced-motion: no-preference) {
    .sweep { animation: spin 5s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  }
  .ptag { position: absolute; font-family: ui-monospace, monospace; font-size: 0.6rem; letter-spacing: 0.12em; background: rgba(2, 10, 4, 0.8); border: 1px solid #35e06f; color: #35e06f; padding: 0.1rem 0.35rem; }
  .kicker { font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.3em; color: #e8a020; }
  h1 { margin-top: 0.9rem; font-weight: 800; text-transform: uppercase; font-size: clamp(2.2rem, 6.5vw, 4.5rem); line-height: 0.95; letter-spacing: -0.02em; }
  .warn { color: #d92b2b; }
  .body { margin-top: 1.1rem; max-width: 34rem; line-height: 1.65; color: #aebdca; }
  .scale { margin-top: 1rem; font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.14em; color: #e8a020; }
  .cta { display: inline-block; margin-top: 1.4rem; background: #d92b2b; color: #fff; font-weight: 800; text-decoration: none; padding: 0.75rem 1.1rem; letter-spacing: 0.04em; }
  .cta:hover { background: #e8a020; color: #0a0f14; }
  .block { margin-top: 3.5rem; border-top: 1px solid #1d2f3f; padding-top: 1.5rem; }
  .rtitle { font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.3em; color: #7b8ea0; margin-bottom: 1.4rem; font-weight: 400; }
  .report { display: flex; gap: 1rem; align-items: baseline; margin-bottom: 1.1rem; }
  .badge { flex-shrink: 0; font-family: ui-monospace, monospace; font-size: 0.62rem; letter-spacing: 0.15em; background: #123420; color: #35e06f; border: 1px solid #35e06f; padding: 0.15rem 0.4rem; }
  .report p { line-height: 1.6; color: #aebdca; font-size: 0.92rem; max-width: 50rem; }
  .report b { color: #dfe8ee; }
  .loop { font-weight: 800; text-transform: uppercase; font-size: clamp(1.1rem, 3.5vw, 1.9rem); letter-spacing: 0.02em; }
  .step { color: #dfe8ee; }
  .arrow { color: #d92b2b; }
  .lines { margin-top: 1.1rem; list-style: none; display: grid; gap: 0.6rem; max-width: 44rem; }
  .lines li { color: #aebdca; line-height: 1.6; padding-left: 1.2rem; position: relative; }
  .lines li::before { content: '▸'; position: absolute; left: 0; color: #e8a020; }
  .stack-grid { display: grid; gap: 1.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .inst h3 { font-family: ui-monospace, monospace; font-size: 0.8rem; letter-spacing: 0.2em; color: #35e06f; font-weight: 700; }
  .inst-note { margin-top: 0.3rem; font-size: 0.8rem; color: #7b8ea0; font-style: italic; }
  .inst-items { margin-top: 0.5rem; font-size: 0.88rem; line-height: 1.7; color: #aebdca; }
  .active { list-style: none; display: grid; gap: 0.9rem; }
  .active li { color: #aebdca; line-height: 1.6; }
  .live { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #d92b2b; margin-right: 0.6rem; box-shadow: 0 0 8px #d92b2b; }
  @media (prefers-reduced-motion: no-preference) {
    .live { animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: 0.35; } }
  }
  .alink { color: #35e06f; text-decoration: none; margin-left: 0.5rem; font-family: ui-monospace, monospace; font-size: 0.8rem; }
  .alink:hover { color: #e8a020; }
  .prose { max-width: 46rem; display: grid; gap: 1rem; }
  .prose p { line-height: 1.7; color: #aebdca; }
  .stations { margin-top: 1.5rem; font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.12em; color: #7b8ea0; line-height: 1.8; }
  .foot { margin-top: 3.5rem; border-top: 1px solid #1d2f3f; padding-top: 1.75rem; }
  .foot-links { margin-top: 1.25rem; font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.15em; color: #7b8ea0; }
  .foot-links a { color: #7b8ea0; }
  .foot-links a:hover { color: #35e06f; }
  a:focus-visible, .cta:focus-visible { outline: 3px solid #e8a020; outline-offset: 2px; }
  @media (max-width: 760px) { .radar-wrap { grid-template-columns: 1fr; } .radar { max-width: 22rem; margin: 0 auto; } }
</style>
