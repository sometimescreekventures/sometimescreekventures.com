---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CreekLine from '../components/CreekLine.astro';
import TopoField from '../components/TopoField.astro';
import WorkCard from '../components/WorkCard.astro';
import { clients, contact, engagements, person, site } from '../data/site';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Home-card leads: each case study fronted by its strongest number. */
const leads: Record<string, { value: string; label: string }> = {
  'cvs-health': {
    value: '15+',
    label: 'engineer squad led on a Fortune-5 program',
  },
  cardio: { value: '99%', label: 'of the platform built solo — ~513 commits' },
  zonal: { value: '~99%', label: 'p95 reduction on core endpoints, under load' },
};
---

<Base
  title="Sean Denton — Cloud & AI Solutions Architect | Sometimes Creek Ventures"
  description={site.description}
>
  <!-- Hero -->
  <section class="on-night relative overflow-hidden bg-night text-bone">
    <TopoField class="pointer-events-none absolute inset-0 h-full w-full" />
    <div
      class="relative mx-auto max-w-5xl px-5 pt-20 pb-32 sm:px-8 sm:pt-28 sm:pb-40"
    >
      <p class="text-sm font-medium tracking-widest text-glow uppercase">
        {person.name}
      </p>
      <h1
        class="mt-4 max-w-3xl font-display text-5xl leading-[1.05] font-semibold tracking-tight sm:text-6xl md:text-7xl"
      >
        Cloud&nbsp;&amp;&nbsp;AI <span class="text-glow">Solutions</span> Architect
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist">
        {person.thesis}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={`mailto:${contact.email}`}
          class="inline-block rounded-md bg-glow px-5 py-2.5 text-sm font-semibold text-night hover:bg-glow-soft"
        >
          {contact.email}
        </a>
        <a
          href="/work"
          class="text-sm font-medium text-glow underline underline-offset-4 hover:text-glow-soft"
        >
          See the work <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <CreekLine
      variant="hero"
      animate
      class="pointer-events-none absolute inset-x-0 bottom-0 h-28 w-full sm:h-36"
    />
  </section>

  <!-- Client strip -->
  <section aria-labelledby="clients-heading" class="border-y border-silt/70 bg-bone">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
      <h2
        id="clients-heading"
        class="text-xs font-medium tracking-widest text-flint uppercase"
      >
        Client engagements
      </h2>
      <ul
        class="mt-5 flex flex-wrap gap-x-8 gap-y-3 font-display text-lg font-medium tracking-tight text-bedrock"
      >
        {clients.map((client) => <li>{client}</li>)}
      </ul>
    </div>
  </section>

  <!-- Engagement models -->
  <section aria-labelledby="engagements-heading">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <h2
        id="engagements-heading"
        class="font-display text-2xl font-semibold tracking-tight sm:text-3xl"
      >
        Four ways to engage
      </h2>
      <dl class="mt-8 divide-y divide-silt/70 border-y border-silt/70">
        {
          engagements.map((engagement) => (
            <div class="grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[14rem_1fr]">
              <dt class="font-display font-semibold tracking-tight">
                {engagement.name}
              </dt>
              <dd class="leading-relaxed text-flint">{engagement.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Featured work -->
  <section aria-labelledby="work-heading" class="border-t border-silt/70">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2
          id="work-heading"
          class="font-display text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Selected work
        </h2>
        <a
          href="/work"
          class="text-sm font-medium text-river underline underline-offset-4 hover:text-river-deep"
        >
          All case studies <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          work.map((entry) => (
            <WorkCard
              href={`/work/${entry.data.slug}`}
              client={entry.data.client}
              title={entry.data.title}
              summary={entry.data.summary}
              lead={leads[entry.data.slug] ?? entry.data.stats[0]!}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Open source teaser -->
  <section aria-labelledby="oss-heading" class="border-t border-silt/70">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2
          id="oss-heading"
          class="font-display text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Open source
        </h2>
        <a
          href="/open-source"
          class="text-sm font-medium text-river underline underline-offset-4 hover:text-river-deep"
        >
          Why these exist <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="mt-8 space-y-5">
        {
          projects.map((project) => (
            <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <a
                href={project.data.repoUrl}
                class="font-display text-lg font-semibold tracking-tight text-river underline underline-offset-4 hover:text-river-deep"
              >
                {project.data.title}
              </a>
              <span class="text-flint">{project.data.tagline}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
