---
/** Editorial work row: lead number, title, summary, link. */
interface Props {
  href: string;
  client: string;
  title: string;
  summary: string;
  lead: { value: string; label: string };
}

const { href, client, title, summary, lead } = Astro.props;
---

<a
  href={href}
  class="group grid gap-x-8 gap-y-2 border-t border-ink py-7 sm:grid-cols-[minmax(11rem,14rem)_1fr]"
>
  <div>
    <p
      class="font-display text-4xl font-extrabold tracking-tight text-accent-deep tabular-nums group-hover:text-accent"
    >
      {lead.value}
    </p>
    <p class="mt-1 text-sm leading-snug text-fog">{lead.label}</p>
  </div>
  <div>
    <p class="text-xs font-semibold tracking-widest text-fog uppercase">
      {client}
    </p>
    <h3
      class="mt-1 font-display text-xl leading-snug font-extrabold tracking-tight uppercase group-hover:underline group-hover:decoration-accent group-hover:decoration-4 group-hover:underline-offset-4"
    >
      {title}
    </h3>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-graphite">
      {summary}
    </p>
    <p class="mt-3 text-sm font-bold tracking-wide text-ink uppercase">
      Case study <span aria-hidden="true" class="text-accent-deep">→</span>
    </p>
  </div>
</a>
