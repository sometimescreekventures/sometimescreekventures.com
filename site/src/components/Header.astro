---
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/open-source', label: 'Open Source' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-silt/70">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-5 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-base font-semibold tracking-tight text-bedrock hover:text-river"
    >
      Sometimes Creek<span class="text-river">&nbsp;Ventures</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-baseline gap-5 text-sm sm:gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  path === item.href || path.startsWith(item.href + '/')
                    ? 'page'
                    : undefined
                }
                class:list={[
                  'hover:text-river',
                  path === item.href || path.startsWith(item.href + '/')
                    ? 'font-medium text-river'
                    : 'text-flint',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
