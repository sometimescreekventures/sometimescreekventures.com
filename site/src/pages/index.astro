---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import {
  clients,
  contact,
  method,
  now,
  person,
  site,
  stack,
  stories,
  ticker,
} from '../data/site';
---

<Base
  title="Sean Denton — I build things that ship | Sometimes Creek Ventures"
  description={site.description}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-12 sm:px-8 sm:pt-20 sm:pb-16">
    <p class="text-sm font-semibold tracking-widest uppercase">
      {person.name} — engineer
    </p>
    <h1
      class="mt-6 font-display leading-[0.92] font-extrabold tracking-tight uppercase"
      style="font-size: clamp(2.9rem, 11.5vw, 8.5rem);"
    >
      <span class="block">I build</span>
      <span class="block">things that</span>
      <span class="block"
        ><span class="outline-word">ship</span><span class="text-accent">.</span
        ></span
      >
    </h1>
    <div
      class="mt-8 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-5"
    >
      <p class="max-w-xl text-lg leading-relaxed font-medium text-graphite">
        I take systems from nothing to production and run them — backend,
        infrastructure, frontend, operations. Twenty-plus years of rockets,
        drive-thrus, hospitals, and tractors. It's just me. That's the point.
      </p>
      <a
        href={`mailto:${contact.email}`}
        class="max-w-full bg-ink px-4 py-3 text-[13px] font-bold tracking-wide break-all text-paper uppercase hover:bg-accent-deep sm:px-5 sm:text-sm"
      >
        {contact.email}
      </a>
    </div>
  </section>

  <Marquee items={ticker} label="Things Sean has built systems for" />

  <!-- 01 The List -->
  <section
    id="list"
    aria-labelledby="list-heading"
    class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-16 sm:px-8"
  >
    <SectionHead number="01" title="The list" />
    <p class="mt-5 max-w-2xl leading-relaxed text-graphite">
      Real things, told straight. No metrics theater — the work is the resume.
    </p>
    <div class="mt-8">
      {
        stories.map((item) => (
          <div class="grid gap-x-8 gap-y-1 border-t border-ink py-6 sm:grid-cols-[minmax(12rem,18rem)_1fr]">
            <h3 class="font-display text-lg leading-snug font-extrabold tracking-tight uppercase">
              {item.hook}<span class="text-accent">.</span>
            </h3>
            <p class="max-w-2xl leading-relaxed text-graphite">{item.story}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 02 Method -->
  <section
    id="method"
    aria-labelledby="method-heading"
    class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-16 sm:px-8"
  >
    <SectionHead number="02" title="Method" />
    <p
      class="mt-8 font-display leading-tight font-extrabold tracking-tight uppercase"
      style="font-size: clamp(1.4rem, 4.5vw, 2.8rem);"
    >
      {
        method.loop.map((step, i) => (
          <>
            <span>{step}</span>
            {i < method.loop.length - 1 && (
              <span aria-hidden="true" class="text-accent">
                {' → '}
              </span>
            )}
          </>
        ))
      }<span class="text-accent">.</span>
    </p>
    <ul class="mt-6 max-w-2xl space-y-3">
      {
        method.lines.map((line) => (
          <li class="flex gap-3 leading-relaxed text-graphite">
            <span aria-hidden="true" class="mt-2 h-2.5 w-2.5 shrink-0 bg-accent" />
            {line}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 03 Stack -->
  <section
    id="stack"
    aria-labelledby="stack-heading"
    class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-16 sm:px-8"
  >
    <SectionHead number="03" title="Stack" />
    <div class="mt-8 grid gap-x-10 sm:grid-cols-2">
      {
        stack.map((group) => (
          <div class="border-t border-ink py-6">
            <h3 class="font-display text-lg font-extrabold tracking-tight uppercase">
              {group.label}<span class="text-accent">.</span>
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-fog italic">
              {group.note}
            </p>
            <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
              {group.items.map((item) => (
                <li class="text-sm font-semibold text-graphite">
                  <span aria-hidden="true" class="text-accent-deep">
                    ▪
                  </span>{' '}
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 04 Now -->
  <section
    id="now"
    aria-labelledby="now-heading"
    class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-16 sm:px-8"
  >
    <SectionHead number="04" title="Now" />
    <ul class="mt-8">
      {
        now.map((item) => (
          <li class="flex flex-wrap items-baseline gap-x-4 border-t border-ink py-5">
            <p class="max-w-3xl leading-relaxed font-medium text-graphite">
              {item.what}
            </p>
            {'links' in item &&
              item.links?.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-bold tracking-wide text-ink uppercase underline decoration-accent decoration-2 underline-offset-4 hover:text-accent-deep"
                >
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 05 Me -->
  <section
    id="me"
    aria-labelledby="me-heading"
    class="mx-auto max-w-6xl scroll-mt-6 px-5 pt-16 sm:px-8"
  >
    <SectionHead number="05" title="Me" />
    <div class="prose-scv mt-8">
      <p>
        I'm a petroleum engineer by degree — The University of Texas at Austin —
        who's spent twenty-plus years shipping software instead. I've been the
        CTO, the principal architect, the tech lead, and the contractor who
        parachutes in when it's on fire. I hold a patent on browser-based
        content protection, I speak about this stuff in public, and I work from
        Georgetown, Texas.
      </p>
      <p>
        Full stack means all of it: set the vision with your founders in the
        morning, design the data model at lunch, code in review by the end of
        the day. I lead teams when there's a team and carry the whole thing
        when there isn't. What I care about is the product actually leaving the
        building — not the deck about it.
      </p>
      <p>
        The company is Sometimes Creek Ventures because that's what's on the
        land here: a Hill Country creek that runs dry most of the year, then
        runs hard when the rain comes. Dormant channel, full capacity on
        demand. That's the deal.
      </p>
    </div>
    <p
      class="mt-10 max-w-3xl border-t border-ink pt-5 text-sm leading-relaxed text-fog"
    >
      Names from along the way: {clients.join(' · ')} — plus a patent
      (US 8,887,290 B1) and a stack of stories that don't fit on a website.
    </p>
  </section>
</Base>
