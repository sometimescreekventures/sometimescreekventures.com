---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Work — Sean Denton | Sometimes Creek Ventures"
  description="Case studies: a Fortune-5 cloud platform automation program, a HIPAA remote patient-monitoring platform built solo, and a performance rescue proven against baselines."
>
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
    <h1
      class="font-display leading-[0.92] font-extrabold tracking-tight uppercase"
      style="font-size: clamp(3rem, 10vw, 7rem);"
    >
      Work<span class="text-accent">.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed font-medium text-graphite">
      Three engagements, three shapes of the same job: own the hard parts —
      architecture, data and security model, infrastructure, path to
      production — and stay accountable until it runs.
    </p>
    <div class="mt-12">
      {
        work.map((entry) => (
          <WorkCard
            href={`/work/${entry.data.slug}`}
            client={entry.data.client}
            title={entry.data.title}
            summary={entry.data.summary}
            lead={entry.data.stats[0]!}
          />
        ))
      }
    </div>
  </div>
</Base>
