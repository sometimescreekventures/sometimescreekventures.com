---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Sometimes Creek Ventures"
  description="This page doesn't exist. The creek bed is dry here."
>
  <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-24">
    <p
      class="font-display leading-none font-extrabold tracking-tight tabular-nums"
      style="font-size: clamp(6rem, 22vw, 16rem);"
    >
      4<span class="outline-word">0</span>4<span class="text-accent">.</span>
    </p>
    <h1
      class="mt-6 font-display text-2xl font-extrabold tracking-tight uppercase sm:text-3xl"
    >
      Dry creek bed.
    </h1>
    <p class="mt-3 max-w-md leading-relaxed text-graphite">
      Nothing flows through this channel. The page you're looking for doesn't
      exist — or has moved downstream.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-block bg-ink px-5 py-3 text-sm font-bold tracking-wide text-paper uppercase hover:bg-accent-deep"
      >
        Back to the source
      </a>
    </p>
  </div>
</Base>
