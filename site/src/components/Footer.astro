---
import { contact, person, site } from '../data/site';
import CreekLine from './CreekLine.astro';
import TopoField from './TopoField.astro';
---

<footer class="on-night relative mt-24 overflow-hidden bg-night text-bone">
  <TopoField class="pointer-events-none absolute inset-0 h-full w-full" />
  <div class="relative mx-auto max-w-5xl px-5 sm:px-8">
    <div class="pt-12">
      <CreekLine tone="dark" />
    </div>
    <section aria-labelledby="contact-heading" class="pt-8 pb-14">
      <h2
        id="contact-heading"
        class="font-display text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        Have something that needs to ship?
      </h2>
      <p class="mt-4 max-w-xl leading-relaxed text-mist">
        Every engagement runs through {site.legalName}. Email is the fastest way
        to reach me — a couple of sentences about what you're building is
        plenty.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={`mailto:${contact.email}`}
          class="inline-block rounded-md bg-glow px-5 py-2.5 text-sm font-semibold text-night hover:bg-glow-soft"
        >
          {contact.email}
        </a>
        <a
          href={contact.linkedin}
          class="text-sm text-mist underline underline-offset-4 hover:text-glow-soft"
        >
          LinkedIn
        </a>
        <a
          href={contact.github}
          class="text-sm text-mist underline underline-offset-4 hover:text-glow-soft"
        >
          GitHub
        </a>
      </div>
    </section>
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-bone/10 py-6 text-xs text-mist"
    >
      <p>© {site.legalName}</p>
      <p>{person.location}</p>
    </div>
  </div>
</footer>
